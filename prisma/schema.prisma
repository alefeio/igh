  protocolNumber    String                 @unique
  subject           String
  summary           String
  status            SupportTicketStatus    @default(OPEN)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  attachmentUrls    String[]               @default([])
  attachmentNames   String[]               @default([])
  /// * Quando o aluno (dono) abriu o chamado pela última vez; usado para "não lido".
  studentLastReadAt DateTime?
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          SupportTicketMessage[]
}

/// * Mensagem de um chamado (aluno ou suporte).
model SupportTicketMessage {
  id            String        @id @default(uuid())
  ticketId      String
  authorUserId  String
  isFromSupport Boolean       @default(false)
  content       String
  createdAt     DateTime      @default(now())
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

/// * Reporte de professor/admin/master à coordenação (comunicação + anexos).
model CoordinatorReport {
  id                  String                     @id @default(uuid())
  protocolNumber      String                     @unique
  fromUserId          String
  subject             String
  summary             String
  status              CoordinatorReportStatus    @default(OPEN)
  attachmentUrls      String[]                   @default([])
  attachmentNames     String[]                   @default([])
  unreadByCoordinator Boolean                    @default(true)
  unreadByReporter    Boolean                    @default(false)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  fromUser            User                       @relation("CoordinatorReportFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  messages            CoordinatorReportMessage[]

  @@index([fromUserId])
  @@index([updatedAt])
}

model CoordinatorReportMessage {
  id                String            @id @default(uuid())
  reportId          String
  authorUserId      String
  isFromCoordinator Boolean           @default(false)
  content           String
  attachmentUrls    String[]          @default([])
  attachmentNames   String[]          @default([])
  createdAt         DateTime          @default(now())
  author            User              @relation("CoordinatorReportMessageAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  report            CoordinatorReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model SiteNewsCategory {
  id       String         @id @default(uuid())
  name     String
  slug     String         @unique
  order    Int            @default(0)
  isActive Boolean        @default(true)
  posts    SiteNewsPost[]
}

model SiteNewsPost {
  id            String            @id @default(uuid())
  title         String
  slug          String            @unique
  excerpt       String?
  content       String?
  coverImageUrl String?
  categoryId    String?
  publishedAt   DateTime?
  isPublished   Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  imageUrls     String[]          @default([])
  category      SiteNewsCategory? @relation(fields: [categoryId], references: [id])
}

model SiteFaqItem {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteTransparencyCategory {
  id        String                     @id @default(uuid())
  name      String
  slug      String                     @unique
  order     Int                        @default(0)
  isActive  Boolean                    @default(true)
  documents SiteTransparencyDocument[]
}

model SiteTransparencyDocument {
  id          String                   @id @default(uuid())
  categoryId  String
  title       String
  description String?
  date        DateTime?                @db.Date
  fileUrl     String?
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  category    SiteTransparencyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model PendingSiteChange {
  id                String    @id @default(uuid())
  requestedByUserId String
  entityType        String
  action            String
  entityId          String?
  payload           Json
  status            String    @default("pending")
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  requestedBy       User      @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy        User?     @relation("PendingSiteChangeReviewedBy", fields: [reviewedByUserId], references: [id])
}

model SmsCampaign {
  id                     String                 @id @default(uuid())
  name                   String
  description            String?
  audienceType           SmsAudienceType
  audienceFilters        Json?
  templateId             String?
  messageContent         String?
  messageCharCount       Int?
  status                 SmsCampaignStatus      @default(DRAFT)
  totalFound             Int                    @default(0)
  totalValid             Int                    @default(0)
  totalMissingPhone      Int                    @default(0)
  totalInvalidPhone      Int                    @default(0)
  totalDuplicatesRemoved Int                    @default(0)
  totalSent              Int                    @default(0)
  totalDelivered         Int                    @default(0)
  totalFailed            Int                    @default(0)
  scheduledAt            DateTime?
  startedAt              DateTime?
  finishedAt             DateTime?
  createdById            String
  confirmedById          String?
  canceledById           String?
  canceledAt             DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  canceledBy             User?                  @relation("SmsCampaignCanceledBy", fields: [canceledById], references: [id])
  confirmedBy            User?                  @relation("SmsCampaignConfirmedBy", fields: [confirmedById], references: [id])
  createdBy              User                   @relation("SmsCampaignCreatedBy", fields: [createdById], references: [id])
  template               SmsTemplate?           @relation(fields: [templateId], references: [id])
  recipients             SmsCampaignRecipient[]

  @@index([status])
  @@index([createdById])
  @@index([scheduledAt])
}

model SmsCampaignRecipient {
  id                    String             @id @default(uuid())
  campaignId            String
  recipientType         String
  recipientId           String
  recipientNameSnapshot String
  phoneSnapshot         String
  phoneNormalized       String
  renderedMessage       String
  providerName          String?
  providerMessageId     String?
  providerResponse      Json?
  status                SmsRecipientStatus @default(PENDING)
  attempts              Int                @default(0)
  errorMessage          String?
  sentAt                DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  campaign              SmsCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, status])
}

model SmsTemplate {
  id           String        @id @default(uuid())
  name         String
  description  String?
  categoryHint String?
  content      String
  active       Boolean       @default(true)
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  campaigns    SmsCampaign[]
  createdBy    User          @relation("SmsTemplateCreatedBy", fields: [createdById], references: [id])

  @@index([active])
}

model EmailCampaign {
  id                     String                   @id @default(uuid())
  name                   String
  description            String?
  audienceType           EmailAudienceType
  audienceFilters        Json?
  templateId             String?
  subject                String?
  htmlContent            String?
  textContent            String?
  status                 EmailCampaignStatus      @default(DRAFT)
  totalFound             Int                      @default(0)
  totalValid             Int                      @default(0)
  totalMissingEmail      Int                      @default(0)
  totalInvalidEmail      Int                      @default(0)
  totalDuplicatesRemoved Int                      @default(0)
  totalSent              Int                      @default(0)
  totalDelivered         Int                      @default(0)
  totalFailed            Int                      @default(0)
  totalOpened            Int                      @default(0)
  totalClicked           Int                      @default(0)
  scheduledAt            DateTime?
  startedAt              DateTime?
  finishedAt             DateTime?
  createdById            String
  confirmedById          String?
  canceledById           String?
  canceledAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  /// * Rodadas de envio em massa (1ª execução, nova rodada após reenfileirar falhas, etc.).
  dispatchCount          Int                      @default(0)
  canceledBy             User?                    @relation("EmailCampaignCanceledBy", fields: [canceledById], references: [id])
  confirmedBy            User?                    @relation("EmailCampaignConfirmedBy", fields: [confirmedById], references: [id])
  createdBy              User                     @relation("EmailCampaignCreatedBy", fields: [createdById], references: [id])
  template               EmailTemplate?           @relation(fields: [templateId], references: [id])
  recipients             EmailCampaignRecipient[]

  @@index([status])
  @@index([createdById])
  @@index([scheduledAt])
}

model EmailCampaignRecipient {
  id                    String               @id @default(uuid())
  campaignId            String
  recipientType         String
  recipientId           String
  recipientNameSnapshot String
  emailSnapshot         String
  emailNormalized       String
  renderedSubject       String
  renderedHtmlContent   String?
  renderedTextContent   String?
  providerName          String?
  providerMessageId     String?
  providerResponse      Json?
  status                EmailRecipientStatus @default(PENDING)
  attempts              Int                  @default(0)
  errorMessage          String?
  sentAt                DateTime?
  deliveredAt           DateTime?
  openedAt              DateTime?
  clickedAt             DateTime?
  bouncedAt             DateTime?
  complainedAt          DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  campaign              EmailCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, status])
}

model EmailTemplate {
  id              String          @id @default(uuid())
  name            String
  description     String?
  categoryHint    String?
  subjectTemplate String
  htmlContent     String?
  textContent     String?
  active          Boolean         @default(true)
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  campaigns       EmailCampaign[]
  createdBy       User            @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id])

  @@index([active])
}

