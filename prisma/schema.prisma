generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// * Ciclo de matrículas (ex.: Ciclo 1 / 2026). Controla visibilidade para matrículas no painel e no site.
model Cycle {
  /// * ID fixo para o seed inicial (ciclo 1 / 2026) e defaults.
  id                      String      @id @default(uuid())
  cycle                   Int
  year                    Int
  isVisibleForEnrollments Boolean     @default(true)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  classGroups ClassGroup[]

  @@unique([cycle, year])
  @@index([year, cycle])
}

model User {
  id                           String                       @id @default(uuid())
  name                         String
  email                        String                       @unique
  passwordHash                 String
  /// * WhatsApp / celular (dígitos). Pedido no cadastro rápido para inscrição em eventos.
  whatsapp                     String?
  /// * Data de nascimento (para aniversário e cadastro). Alunos também mantêm em Student.
  birthDate                    DateTime?                    @db.Date
  role                         UserRole
  isActive                     Boolean                      @default(true)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  mustChangePassword           Boolean                      @default(false)
  isAdmin                      Boolean                      @default(false)
  /// * Overlay: Administrador Site quando o papel-base é outro.
  isSiteAdmin                  Boolean                      @default(false)
  /// * Deprecated: perfil Coordenador removido; mantido no schema por compatibilidade.
  isCoordinator                Boolean                      @default(false)
  /// * Acesso sobreposto como Coordenador de Polos (além do papel-base).
  isPoloCoordinator            Boolean                      @default(false)
  /// * Acesso sobreposto à Gerência Administrativa (além do papel-base).
  isAdminManager               Boolean                      @default(false)
  /// * Chaves dos tutoriais já concluídos pelo usuário (ex.: student-dashboard-tutorial-done).
  completedTutorialKeys        String[]                     @default([])
  auditLogs                    AuditLog[]                   @relation("UserAuditLogs")
  coordinatorReportsFrom       CoordinatorReport[]          @relation("CoordinatorReportFrom")
  coordinatorReportMessages    CoordinatorReportMessage[]   @relation("CoordinatorReportMessageAuthor")
  lessonLastEdited             CourseLesson[]               @relation("LessonLastEditedBy")
  emailCampaignsCanceled       EmailCampaign[]              @relation("EmailCampaignCanceledBy")
  emailCampaignsConfirmed      EmailCampaign[]              @relation("EmailCampaignConfirmedBy")
  emailCampaignsCreated        EmailCampaign[]              @relation("EmailCampaignCreatedBy")
  emailTemplatesCreated        EmailTemplate[]              @relation("EmailTemplateCreatedBy")
  legalDocumentVersionsCreated LegalDocumentVersion[]       @relation("LegalDocumentVersionCreatedBy")
  lessonQuestionStaffReplies   LessonQuestionTeacherReply[] @relation("LessonQuestionStaffReply")
  onboardingGuidesUpdated      OnboardingGuide[]            @relation("OnboardingGuideUpdatedBy")
  onboardingVisits             OnboardingUserVisit?
  pendingSiteChangesRequested  PendingSiteChange[]
  pendingSiteChangesReviewed   PendingSiteChange[]          @relation("PendingSiteChangeReviewedBy")
  pendingTestimonialsReviewed  PendingTestimonial[]         @relation("PendingTestimonialReviewedBy")
  platformExperienceFeedbacks  PlatformExperienceFeedback[]
  sentEmails                   SentEmail[]                  @relation("SentEmailPerformedBy")
  smsCampaignsCanceled         SmsCampaign[]                @relation("SmsCampaignCanceledBy")
  smsCampaignsConfirmed        SmsCampaign[]                @relation("SmsCampaignConfirmedBy")
  smsCampaignsCreated          SmsCampaign[]                @relation("SmsCampaignCreatedBy")
  smsTemplatesCreated          SmsTemplate[]                @relation("SmsTemplateCreatedBy")
  studentsDeleted              Student[]                    @relation("StudentDeletedBy")
  student                      Student?
  studentAttachments           StudentAttachment[]          @relation("StudentAttachmentUploadedBy")
  supportTickets               SupportTicket[]
  teacher                      Teacher?
  accessLogs                   UserAccessLog[]
  legalAcceptance              UserLegalAcceptance?
  notifications                UserNotification[]
  pageVisits                   UserPageVisit[]
  verificationTokens           VerificationToken[]
  siteQrCodesCreated           SiteQrCode[]                 @relation("SiteQrCodeCreatedBy")
  marketingCampaignResponses       MarketingCampaignResponse[]
  marketingCampaignResponseLikes   MarketingCampaignResponseLike[]
  ighCommunityTopicsModerated      IghCommunityTopic[]          @relation("IghCommunityTopicModeratedBy")
  ighCommunityRepliesModerated     IghCommunityReply[]          @relation("IghCommunityReplyModeratedBy")
  ighCommunityTopicsAuthored       IghCommunityTopic[]          @relation("IghCommunityTopicAuthor")
  ighCommunityRepliesAuthored      IghCommunityReply[]          @relation("IghCommunityReplyAuthor")
  holidayEventRegistrations          HolidayEventRegistration[]
  coordinatedPolos                   Polo[]
  /// * Código único de indicação deste usuário (link /cadastro?ref=...).
  referralCode                       UserReferralCode?
  /// * Indicações feitas por este usuário.
  referralsMade                      StudentReferral[]          @relation("ReferralReferrer")
  /// * Quem indicou este usuário no cadastro (antes ou junto da criação do Student).
  referredByUserId                   String?
  referredByUser                     User?                      @relation("UserReferredBy", fields: [referredByUserId], references: [id], onDelete: SetNull)
  usersReferred                      User[]                     @relation("UserReferredBy")
  /// * Ficha de colaborador vinculada a esta conta (Gerência Administrativa).
  employee                           Employee?                  @relation("EmployeeUser")
  employeesCreated                   Employee[]                 @relation("EmployeeCreatedBy")
  employeesDeleted                   Employee[]                 @relation("EmployeeDeletedBy")
  employeeDocumentsUploaded          EmployeeDocument[]         @relation("EmployeeDocumentUploadedBy")
  documentTemplatesCreated           DocumentTemplate[]         @relation("DocumentTemplateCreatedBy")
  employeeContractsCreated           EmployeeContract[]         @relation("EmployeeContractCreatedBy")
  employeeMonthlyInvoicesCreated     EmployeeMonthlyInvoice[]   @relation("EmployeeMonthlyInvoiceCreatedBy")
  financialCategoriesCreated         FinancialCategory[]        @relation("FinancialCategoryCreatedBy")
  financialEntriesCreated            FinancialEntry[]           @relation("FinancialEntryCreatedBy")
  financialEntriesResponsible        FinancialEntry[]           @relation("FinancialEntryResponsible")
  inventoryItemsCreated              InventoryItem[]            @relation("InventoryItemCreatedBy")
  inventoryMovementsCreated          InventoryMovement[]        @relation("InventoryMovementCreatedBy")
  inventoryMovementsResponsible      InventoryMovement[]        @relation("InventoryMovementResponsible")
  donatariasCreated                  Donataria[]                @relation("DonatariaCreatedBy")
  donationsCreated                   Donation[]                 @relation("DonationCreatedBy")
  equipmentCatalogCreated            EquipmentCatalogItem[]     @relation("EquipmentCatalogCreatedBy")
  technicalVisitsCreated             TechnicalVisit[]           @relation("TechnicalVisitCreatedBy")
  donorInstitutionUpdated            DonorInstitutionSettings[] @relation("DonorInstitutionUpdatedBy")
  annualGoalsCreated                 AnnualGoal[]               @relation("AnnualGoalCreatedBy")
  paymentAgreementsCreated           PaymentAgreement[]         @relation("PaymentAgreementCreatedBy")
  /// * Turmas criadas por este usuário (admin/master).
  classGroupsCreated                 ClassGroup[]               @relation("ClassGroupCreatedBy")
  /// * Cursos criados por este usuário (admin/master).
  coursesCreated                     Course[]                   @relation("CourseCreatedBy")

  @@index([referredByUserId])
}

/// * Navegação na área logada — rota (pathname) por utilizador, para o Master acompanhar páginas vistas.
model UserPageVisit {
  id        String   @id @default(uuid())
  userId    String
  /// * Caminho da rota (ex.: /dashboard), sem query string.
  path      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

/// * Login com sucesso — histórico para o Master (IP/User-Agent conforme cabeçalhos do proxy).
model UserAccessLog {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  /// * EMAIL ou CPF (mesmo campo `kind` do formulário de login).
  loginKind String   @default("EMAIL")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model UserNotification {
  id        String               @id @default(uuid())
  userId    String
  kind      UserNotificationKind
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  /// * Chave única para não repetir o mesmo evento (ex.: mesma aula liberada).
  dedupeKey String               @unique
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}

model LegalDocumentVersion {
  id                 String                @id @default(uuid())
  kind               LegalDocumentKind
  /// * Rótulo de versão exibido ao usuário (ex.: 1.0, 2025-03). Único por tipo de documento.
  versionLabel       String
  title              String                @default("")
  contentRich        String
  status             LegalDocumentStatus   @default(DRAFT)
  publishedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  createdByUserId    String?
  createdBy          User?                 @relation("LegalDocumentVersionCreatedBy", fields: [createdByUserId], references: [id])
  cookieAcceptances  UserLegalAcceptance[] @relation("AcceptanceCookie")
  privacyAcceptances UserLegalAcceptance[] @relation("AcceptancePrivacy")
  termsAcceptances   UserLegalAcceptance[] @relation("AcceptanceTerms")

  @@unique([kind, versionLabel])
  @@index([kind, status])
}

/// * Registro por usuário logado das versões publicadas aceitas (para não reexibir o banner).
model UserLegalAcceptance {
  id               String                @id @default(uuid())
  userId           String                @unique
  termsVersionId   String?
  privacyVersionId String?
  cookieVersionId  String?
  acceptedAt       DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  cookieVersion    LegalDocumentVersion? @relation("AcceptanceCookie", fields: [cookieVersionId], references: [id])
  privacyVersion   LegalDocumentVersion? @relation("AcceptancePrivacy", fields: [privacyVersionId], references: [id])
  termsVersion     LegalDocumentVersion? @relation("AcceptanceTerms", fields: [termsVersionId], references: [id])
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// * Conteúdo de onboarding por perfil (rich text), editável por Master/Admin.
model OnboardingGuide {
  id          String   @id @default(uuid())
  role        UserRole @unique
  title       String   @default("")
  contentRich String
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("OnboardingGuideUpdatedBy", fields: [updatedById], references: [id])
}

/// * Registro de acesso à página de onboarding (feedback para administradores).
model OnboardingUserVisit {
  id          String   @id @default(uuid())
  userId      String   @unique
  role        UserRole
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  viewCount   Int      @default(1)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastSeenAt])
}

/// * Avaliação da experiência do aluno (plataforma, aulas, professor, comentário e indicação).
model PlatformExperienceFeedback {
  id              String   @id @default(uuid())
  userId          String
  /// * Texto livre: quem indicaria, contato, etc.
  referral        String?
  createdAt       DateTime @default(now())
  /// * Nota de 1 a 10 — plataforma (navegação, uso geral).
  ratingPlatform  Int
  /// * Nota de 1 a 10 — aulas e conteúdo.
  ratingLessons   Int
  /// * Nota de 1 a 10 — atuação do(s) professor(es).
  ratingTeacher   Int
  /// * Comentário opcional sobre a plataforma.
  commentPlatform String?
  commentLessons  String?
  commentTeacher  String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/// * Campanha de marketing / pesquisa (ex.: Dia das Mães).
model MarketingCampaign {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responses MarketingCampaignResponse[]
  guestResponses MarketingCampaignGuestResponse[]

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
}

/// * Resposta do usuário para uma campanha (nota + comentário).
model MarketingCampaignResponse {
  id          String   @id @default(uuid())
  campaignId  String
  userId      String
  ratingStars Int
  comment     String?
  createdAt   DateTime @default(now())

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    MarketingCampaignResponseLike[]
  publicLikes MarketingCampaignResponsePublicLike[]

  @@index([campaignId])
  @@index([userId])
  @@index([createdAt])
  @@unique([campaignId, userId])
}

/// * Curtida de um aluno em uma declaração de outro aluno na mesma campanha (uma por par usuário×resposta).
model MarketingCampaignResponseLike {
  id         String   @id @default(uuid())
  responseId String
  userId     String
  createdAt  DateTime @default(now())

  response MarketingCampaignResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  user     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([responseId, userId])
  @@index([responseId])
  @@index([userId])
}

/// * Curtida pública (anônima) para mensagens exibidas no site institucional (bloqueio por cookie).
model MarketingCampaignResponsePublicLike {
  id         String   @id @default(uuid())
  responseId String
  anonId     String
  createdAt  DateTime @default(now())

  response MarketingCampaignResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, anonId])
  @@index([responseId])
  @@index([anonId])
}

/// * Participação pública (não-aluno) na campanha (mensagem + nome).
model MarketingCampaignGuestResponse {
  id         String   @id @default(uuid())
  campaignId String
  name       String
  email      String?
  /// * Nota simbólica em corações (1–10), alinhada à participação do aluno na campanha.
  ratingStars Int      @default(5)
  comment    String
  createdAt  DateTime @default(now())

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  publicLikes MarketingCampaignGuestResponsePublicLike[]

  @@index([campaignId])
  @@index([createdAt])
}

model MarketingCampaignGuestResponsePublicLike {
  id              String   @id @default(uuid())
  guestResponseId String
  anonId          String
  createdAt       DateTime @default(now())

  guestResponse MarketingCampaignGuestResponse @relation(fields: [guestResponseId], references: [id], onDelete: Cascade)

  @@unique([guestResponseId, anonId])
  @@index([guestResponseId])
  @@index([anonId])
}

model SentEmail {
  id                String   @id @default(uuid())
  to                String
  subject           String
  messageId         String?
  emailType         String
  entityType        String?
  entityId          String?
  sentAt            DateTime @default(now())
  performedByUserId String?
  performedByUser   User?    @relation("SentEmailPerformedBy", fields: [performedByUserId], references: [id])
}

/// Fila de e-mails transacionais quando a cota diária do Resend (ex.: 100/dia) estiver esgotada.
model EmailOutbox {
  id                String            @id @default(uuid())
  to                String
  subject           String
  html              String
  emailType         String
  entityType        String?
  entityId          String?
  performedByUserId String?
  status            EmailOutboxStatus @default(PENDING)
  attempts          Int               @default(0)
  errorMessage      String?
  createdAt         DateTime          @default(now())
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([emailType, entityType, entityId])
}

enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
}

model VerificationToken {
  id           String                @id @default(cuid())
  userId       String
  studentId    String?
  enrollmentId String?
  type         VerificationTokenType
  tokenHash    String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime              @default(now())
  enrollment   Enrollment?           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student      Student?              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Teacher {
  id                    String                       @id @default(uuid())
  name                  String
  phone                 String?
  email                 String?
  isActive              Boolean                      @default(true)
  deletedAt             DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  userId                String?                      @unique
  photoUrl              String?
  /// * URL da assinatura (PNG/JPG) usada no verso do certificado de conclusão.
  signatureUrl          String?
  classGroups           ClassGroup[]
  classGroupTeachers    ClassGroupTeacher[]
  lessonQuestionReplies LessonQuestionTeacherReply[]
  lessonQuestionsAuthored EnrollmentLessonQuestion[] @relation("LessonQuestionTeacherAuthor")
  examsCreated          ClassGroupExam[]             @relation("ExamCreatedByTeacher")
  holidayEventsResponsibleFor Holiday[]              @relation("HolidayResponsibleTeacher")
  holidayEventAttendancesMarked HolidayEventRegistration[] @relation("HolidayEventAttendanceMarkedByTeacher")
  user                  User?                        @relation(fields: [userId], references: [id])
}

model Course {
  id              String                @id @default(uuid())
  name            String                @unique
  description     String?
  workloadHours   Int?
  status          CourseStatus          @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  content         String?
  imageUrl        String?
  slug            String                @unique
  /// * Usuário (admin/master) que criou o curso.
  createdByUserId String?
  createdByUser   User?                 @relation("CourseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  classGroups     ClassGroup[]
  modules         CourseModule[]
  siteFormations  SiteFormationCourse[]
  siteUnits       SiteUnitCourse[]

  @@index([createdByUserId])
}

model CourseModule {
  id          String         @id @default(uuid())
  courseId    String
  title       String
  description String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lessons     CourseLesson[]
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
}

model CourseLesson {
  id                 String                     @id @default(uuid())
  moduleId           String
  title              String
  order              Int                        @default(0)
  durationMinutes    Int?
  contentRich        String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  videoUrl           String?
  imageUrls          String[]                   @default([])
  /// * URL do PDF da aula (material complementar).
  pdfUrl             String?
  /// * URLs dos arquivos de apoio da aula (material complementar).
  attachmentUrls     String[]                   @default([])
  /// * Resumo rápido da aula: o que será aprendido (exibido no topo para o aluno).
  summary            String?
  /// * Última edição: usuário que alterou o conteúdo (para auditoria pelo master).
  lastEditedByUserId String?
  lastEditedAt       DateTime?
  /// * Nomes exibidos para cada URL (mesmo índice que attachmentUrls).
  attachmentNames    String[]                   @default([])
  classSessions      ClassSession[]
  lastEditedByUser   User?                      @relation("LessonLastEditedBy", fields: [lastEditedByUserId], references: [id])
  module             CourseModule               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  exercises          CourseLessonExercise[]
  lessonFavorites    EnrollmentLessonFavorite[]
  lessonNotes        EnrollmentLessonNote[]
  lessonPassages     EnrollmentLessonPassage[]
  lessonProgress     EnrollmentLessonProgress[]

  @@unique([moduleId, order])
}

/// * Exercício de múltipla escolha vinculado à aula.
model CourseLessonExercise {
  id                   String                           @id @default(uuid())
  lessonId             String
  order                Int                              @default(0)
  question             String
  /// * Justificativa opcional da resposta correta (exibida ao aluno após responder).
  answerJustification  String?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  lesson               CourseLesson                     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options              CourseLessonExerciseOption[]
  answers              EnrollmentLessonExerciseAnswer[]

  @@index([lessonId])
}

/// * Opção de resposta de um exercício de múltipla escolha.
model CourseLessonExerciseOption {
  id         String               @id @default(uuid())
  exerciseId String
  order      Int                  @default(0)
  text       String
  isCorrect  Boolean              @default(false)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  exercise   CourseLessonExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

/// * Polo operacional do IGH (agrupa locais físicos e um coordenador de polos).
model Polo {
  id                 String         @id @default(uuid())
  name               String
  isActive           Boolean        @default(true)
  coordinatorUserId  String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  coordinator        User           @relation(fields: [coordinatorUserId], references: [id])
  locations          PoloLocation[]
  employees          Employee[]
  financialEntries   FinancialEntry[]

  @@index([coordinatorUserId])
  @@index([isActive])
}

/// * Local físico pertencente a um polo (turmas podem ser vinculadas a um local).
model PoloLocation {
  id          String       @id @default(uuid())
  poloId      String
  name        String
  address     String?
  /// * Cidade de emissão do certificado para turmas deste local (ex.: "Belém", "Brasília").
  city        String?
  /// * UF da cidade de emissão (ex.: "PA", "DF").
  state       String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  polo        Polo         @relation(fields: [poloId], references: [id], onDelete: Cascade)
  classGroups ClassGroup[]

  @@unique([poloId, name])
  @@index([poloId])
}

model ClassGroup {
  id               String           @id @default(uuid())
  courseId         String
  teacherId        String
  /// * Turma pertence a um ciclo (ex.: Ciclo 1 / 2026).
  cycleId          String           @default("00000000-0000-0000-0000-000000000001")
  daysOfWeek       String[]
  startTime        String
  endTime          String
  capacity         Int
  status           ClassGroupStatus @default(PLANEJADA)
  /// * false = Interna (padrão); true = Externa (fora do site público; matrícula privilegiada).
  isExternal       Boolean          @default(false)
  location         String?
  /// * Local do polo (quando definido, a turma pertence ao polo daquele local).
  poloLocationId   String?
  /// * Usuário (admin/master) que criou a turma.
  createdByUserId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  endDate          DateTime?        @db.Date
  startDate        DateTime         @db.Date
  preventAutoClose Boolean          @default(false)
  course           Course           @relation(fields: [courseId], references: [id])
  teacher          Teacher          @relation(fields: [teacherId], references: [id])
  classGroupTeachers ClassGroupTeacher[]
  cycle            Cycle            @relation(fields: [cycleId], references: [id])
  poloLocation     PoloLocation?    @relation(fields: [poloLocationId], references: [id], onDelete: SetNull)
  createdByUser    User?            @relation("ClassGroupCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sessions         ClassSession[]
  enrollments      Enrollment[]
  waitlistEntries  EnrollmentWaitlist[]
  waitlistSeatOffers WaitlistSeatOffer[]
  exams            ClassGroupExam[]

  @@index([poloLocationId])
  @@index([createdByUserId])
}

model ClassGroupTeacher {
  id           String     @id @default(uuid())
  classGroupId String
  teacherId    String
  createdAt    DateTime   @default(now())
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classGroupId, teacherId])
  @@index([teacherId])
}

enum ClassGroupExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ClassGroupExamTimingMode {
  FROM_STUDENT_START
  FROM_EXAM_START
}

enum ClassGroupExamSelectionMode {
  RANDOM
  MANUAL
}

enum ClassGroupExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  ABANDONED
}

/// * Prova formal da turma (questões do banco de exercícios do curso).
model ClassGroupExam {
  id                 String                      @id @default(uuid())
  classGroupId       String
  title              String
  instructions       String?
  status             ClassGroupExamStatus        @default(DRAFT)
  availableFrom      DateTime
  availableUntil     DateTime
  durationMinutes    Int
  timingMode         ClassGroupExamTimingMode    @default(FROM_STUDENT_START)
  selectionMode      ClassGroupExamSelectionMode @default(RANDOM)
  questionCount      Int
  /// * IDs de exercícios escolhidos manualmente (ordem preservada).
  manualExerciseIds  String[]                    @default([])
  shuffleQuestions   Boolean                     @default(true)
  shuffleOptions     Boolean                     @default(true)
  maxAttempts        Int                         @default(1)
  showScoreAfterSubmit Boolean                   @default(true)
  createdByTeacherId String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  classGroup         ClassGroup                  @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  createdByTeacher   Teacher?                    @relation("ExamCreatedByTeacher", fields: [createdByTeacherId], references: [id], onDelete: SetNull)
  attempts           ClassGroupExamAttempt[]

  @@index([classGroupId])
  @@index([classGroupId, status])
  @@index([createdByTeacherId])
}

model ClassGroupExamAttempt {
  id             String                      @id @default(uuid())
  examId         String
  enrollmentId   String
  attemptNumber  Int                         @default(1)
  status         ClassGroupExamAttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime
  expiresAt      DateTime
  submittedAt    DateTime?
  scorePercent   Int?
  correctCount   Int?
  totalQuestions Int?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  exam           ClassGroupExam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  enrollment     Enrollment                  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  questions ClassGroupExamAttemptQuestion[]
  answers   ClassGroupExamAnswer[]

  @@unique([examId, enrollmentId, attemptNumber])
  @@index([examId])
  @@index([enrollmentId])
}

/// * Snapshot das questões da tentativa (gerado ao iniciar).
model ClassGroupExamAttemptQuestion {
  id              String   @id @default(uuid())
  attemptId       String
  order           Int
  exerciseId      String
  questionText    String
  /// * [{ id, text, order }] — sem indicar qual é correta.
  optionsJson     Json
  correctOptionId String
  attempt         ClassGroupExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  answer          ClassGroupExamAnswer?

  @@index([attemptId])
}

model ClassGroupExamAnswer {
  id                String   @id @default(uuid())
  attemptId         String
  attemptQuestionId String   @unique
  selectedOptionId  String?
  correct           Boolean?
  answeredAt        DateTime?
  attempt           ClassGroupExamAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptQuestion   ClassGroupExamAttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, attemptQuestionId])
  @@index([attemptId])
}

model ClassSession {
  id                 String              @id @default(uuid())
  classGroupId       String
  sessionDate        DateTime            @db.Date
  startTime          String
  endTime            String
  status             ClassSessionStatus  @default(SCHEDULED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lessonId           String?
  classGroup         ClassGroup          @relation(fields: [classGroupId], references: [id])
  lesson             CourseLesson?       @relation(fields: [lessonId], references: [id])
  sessionAttendances SessionAttendance[]

  @@unique([classGroupId, sessionDate])
}

/// * Frequência do aluno em uma sessão de aula (professor marca presença).
model SessionAttendance {
  id                   String       @id @default(uuid())
  classSessionId       String
  enrollmentId         String
  present              Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  /// * Justificativa informada pelo professor quando o aluno está ausente (opcional).
  absenceJustification String?
  classSession         ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  enrollment           Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, enrollmentId])
  @@index([classSessionId])
  @@index([enrollmentId])
}

model TimeSlot {
  id        String   @id @default(uuid())
  startTime String
  endTime   String
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Holiday {
  id                 String                     @id @default(uuid())
  date               DateTime                   @db.Date
  name               String?
  isActive           Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  recurring          Boolean                    @default(false)
  /// * Se preenchidos (HH:mm), é evento: só turmas cujo horário cruza este intervalo são adiadas neste dia.
  eventStartTime     String?
  eventEndTime       String?
  /// * Eventos com horário podem aceitar inscrição pública (portal).
  allowsRegistration Boolean                    @default(false)
  /// * Texto extra exibido no calendário público (opcional).
  publicDescription  String?
  /// * Subtítulo discreto abaixo do nome no calendário público (eventos).
  subtitle           String?
  /// * Professor responsável (opcional) — usado para marcação de presença e certificado.
  responsibleTeacherId String?
  registrations      HolidayEventRegistration[]
  responsibleTeacher Teacher?                   @relation("HolidayResponsibleTeacher", fields: [responsibleTeacherId], references: [id], onDelete: SetNull)

  @@index([responsibleTeacherId])
}

/// * Banner horizontal de destaque na página pública /calendario (singleton).
model HolidayCalendarBanner {
  id        String   @id @default("singleton")
  title     String?
  subtitle  String?
  ctaLabel  String?
  ctaHref   String?
  imageUrl  String?
  isActive  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// * Inscrição em ocorrência de evento institucional (usuário logado ou convidado sem conta).
model HolidayEventRegistration {
  id                      String    @id @default(uuid())
  holidayId               String
  /// * Preenchido quando a inscrição é de usuário autenticado.
  userId                  String?
  /// * Data da ocorrência (YYYY-MM-DD), importante para eventos recorrentes.
  occurrenceDate          String
  createdAt               DateTime  @default(now())
  confirmationEmailSentAt DateTime?
  reminderEmailSentAt     DateTime?
  /// * Dados de inscrição simplificada (sem criar conta).
  guestName               String?
  guestPhone              String?
  guestEmail              String?
  guestCpf                String?
  /// * Presença confirmada pelo professor responsável.
  present                 Boolean?
  attendanceMarkedAt      DateTime?
  attendanceMarkedByTeacherId String?
  /// * Certificado gerado automaticamente (somente se present=true).
  certificateUrl          String?
  certificatePublicId     String?
  certificateFileName     String?
  holiday                 Holiday   @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  user                    User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceMarkedByTeacher Teacher? @relation("HolidayEventAttendanceMarkedByTeacher", fields: [attendanceMarkedByTeacherId], references: [id], onDelete: SetNull)

  @@unique([holidayId, userId, occurrenceDate])
  @@unique([holidayId, guestPhone, occurrenceDate])
  @@index([occurrenceDate])
  @@index([userId])
  @@index([guestPhone])
  @@index([holidayId, occurrenceDate])
  @@index([attendanceMarkedByTeacherId])
}

model AuditLog {
  id                String   @id @default(uuid())
  entityType        String
  entityId          String
  action            String
  diffJson          String
  performedByUserId String?
  createdAt         DateTime @default(now())
  performedByUser   User?    @relation("UserAuditLogs", fields: [performedByUserId], references: [id])
}

model Student {
  id                    String              @id @default(uuid())
  name                  String
  birthDate             DateTime            @db.Date
  cpf                   String              @unique
  rg                    String
  phone                 String
  gender                Gender
  hasDisability         Boolean             @default(false)
  disabilityDescription String?
  educationLevel        EducationLevel
  isStudying            Boolean             @default(false)
  studyShift            StudyShift?
  guardianName          String?
  guardianCpf           String?
  guardianRg            String?
  guardianPhone         String?
  guardianRelationship  String?
  deletedAt             DateTime?
  deletedByUserId       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  city                  String              @default("Belém")
  complement            String?
  neighborhood          String              @default("")
  number                String              @default("")
  state                 String              @default("PA")
  street                String              @default("")
  email                 String?
  cep                   String?
  userId                String?             @unique
  enrollments           Enrollment[]
  waitlistEntries       EnrollmentWaitlist[]
  waitlistSeatOffers    WaitlistSeatOffer[]
  deletedByUser         User?               @relation("StudentDeletedBy", fields: [deletedByUserId], references: [id])
  user                  User?               @relation(fields: [userId], references: [id])
  attachments           StudentAttachment[]
  verificationTokens    VerificationToken[]
  ighCommunityTopics    IghCommunityTopic[]
  ighCommunityReplies   IghCommunityReply[]
  /// * Indicação recebida (no máximo uma).
  referralReceived      StudentReferral?
}

/// * Código estável de indicação por usuário (qualquer perfil).
model UserReferralCode {
  userId    String   @id
  /// * Código curto usado em ?ref= (ex.: a7k2m9xq).
  code      String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
}

/// * Vínculo indicador → aluno indicado, com marcos de gamificação.
model StudentReferral {
  id                String    @id @default(uuid())
  referrerUserId    String
  referredStudentId String    @unique
  registeredAt      DateTime  @default(now())
  /// * Momento da 1ª presença (SessionAttendance.present = true).
  firstAttendanceAt DateTime?
  /// * Momento da 1ª certificação apta/emitida em alguma matrícula.
  certifiedAt       DateTime?
  referrer          User      @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referredStudent   Student   @relation(fields: [referredStudentId], references: [id], onDelete: Cascade)

  @@index([referrerUserId, registeredAt(sort: Desc)])
}

model Enrollment {
  id                    String                           @id @default(uuid())
  studentId             String
  classGroupId          String
  enrolledAt            DateTime                         @default(now())
  status                String                           @default("ACTIVE")
  enrollmentConfirmedAt DateTime?
  termsAcceptedAt       DateTime?
  termsVersion          String?
  confirmationMethod    String?
  confirmedIp           String?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  certificateUrl        String?
  certificatePublicId   String?
  certificateFileName   String?
  /// * Data usada no texto do certificado (estável após a 1ª emissão).
  certificateIssuedAt   DateTime?
  /// * Se true, o aluno está apto a receber certificado nesta matrícula (além da turma encerrada).
  /// * Passa a true automaticamente com ≥70% de presença; o professor pode alternar manualmente.
  certificateEligible   Boolean                          @default(false)
  /// * Se true, certificateEligible foi definido pelo professor e a regra automática de 70% não sobrescreve.
  certificateEligibleManual Boolean                      @default(false)
  isPreEnrollment       Boolean                          @default(false)
  classGroup            ClassGroup                       @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  student               Student                          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exerciseAnswers       EnrollmentLessonExerciseAnswer[]
  lessonFavorites       EnrollmentLessonFavorite[]
  lessonNotes           EnrollmentLessonNote[]
  lessonPassages        EnrollmentLessonPassage[]
  lessonProgress        EnrollmentLessonProgress[]
  lessonQuestions       EnrollmentLessonQuestion[]
  questionReplies       EnrollmentLessonQuestionReply[]
  sessionAttendances    SessionAttendance[]
  verificationTokens    VerificationToken[]
  examAttempts          ClassGroupExamAttempt[]
  /// * Reserva convertida nesta matrícula (se houver).
  convertedFromWaitlist EnrollmentWaitlist?
}

/// * Lista de espera / cadastro de reserva para turmas sem vagas.
/// * Não ocupa vaga até ser promovida a Enrollment (FIFO por createdAt).
model EnrollmentWaitlist {
  id                      String      @id @default(uuid())
  studentId               String
  classGroupId            String
  /// * WAITING | CONVERTED | CANCELLED
  status                  String      @default("WAITING")
  notes                   String?
  convertedEnrollmentId   String?     @unique
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  student                 Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup              ClassGroup  @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  convertedEnrollment     Enrollment? @relation(fields: [convertedEnrollmentId], references: [id], onDelete: SetNull)
  seatOffers              WaitlistSeatOffer[]

  @@unique([classGroupId, studentId])
  @@index([classGroupId, status, createdAt])
  @@index([studentId, status])
}

/// * Oferta de vaga em outra turma para quem está na lista de espera (e-mail com link).
model WaitlistSeatOffer {
  id                 String   @id @default(uuid())
  studentId          String
  /// * Turma com vaga oferecida.
  classGroupId       String
  /// * Reserva original (WAITING) que motivou a oferta.
  sourceWaitlistId   String?
  tokenHash          String   @unique
  /// * PENDING | ACCEPTED | EXPIRED | CANCELLED
  status             String   @default("PENDING")
  expiresAt          DateTime
  emailedAt          DateTime @default(now())
  acceptedAt         DateTime?
  createdAt          DateTime @default(now())
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup         ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  sourceWaitlist     EnrollmentWaitlist? @relation(fields: [sourceWaitlistId], references: [id], onDelete: SetNull)

  @@unique([studentId, classGroupId])
  @@index([status, expiresAt])
  @@index([classGroupId])
}

model EnrollmentLessonFavorite {
  id           String       @id @default(uuid())
  enrollmentId String
  lessonId     String
  createdAt    DateTime     @default(now())
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model EnrollmentLessonNote {
  id                 String       @id @default(uuid())
  enrollmentId       String
  lessonId           String
  content            String
  videoTimestampSecs Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  enrollment         Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson             CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, lessonId])
}

model EnrollmentLessonPassage {
  id           String       @id @default(uuid())
  enrollmentId String
  lessonId     String
  text         String
  startOffset  Int
  createdAt    DateTime     @default(now())
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, lessonId])
}

model EnrollmentLessonProgress {
  id                   String       @id @default(uuid())
  enrollmentId         String
  lessonId             String
  completed            Boolean      @default(false)
  percentWatched       Int          @default(0)
  percentRead          Int          @default(0)
  completedAt          DateTime?
  updatedAt            DateTime     @updatedAt
  lastAccessedAt       DateTime?
  totalMinutesStudied  Int          @default(0)
  /// * Último slide (índice 0-based) visualizado; null = não definido ou concluiu o último.
  lastContentPageIndex Int?
  enrollment           Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson               CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

/// * Dúvida ou comentário do aluno sobre a aula (fórum por aula).
model EnrollmentLessonQuestion {
  id             String                          @id @default(uuid())
  enrollmentId   String?
  teacherAuthorId String?
  lessonId       String
  content        String
  /// * Fotos anexadas à publicação no fórum da aula (URLs no Apimages).
  imageUrls      String[]                        @default([])
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  enrollment     Enrollment?                     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacherAuthor  Teacher?                        @relation("LessonQuestionTeacherAuthor", fields: [teacherAuthorId], references: [id], onDelete: Cascade)
  replies        EnrollmentLessonQuestionReply[]
  teacherReplies LessonQuestionTeacherReply[]

  @@index([enrollmentId, lessonId])
  @@index([teacherAuthorId])
  @@index([lessonId])
}

/// * Resposta oficial do professor ou da equipe (admin/master) a uma dúvida na aula.
model LessonQuestionTeacherReply {
  id          String                   @id @default(uuid())
  questionId  String
  /// * Professor do curso (mutuamente exclusivo com staffUserId em regra de negócio).
  teacherId   String?
  content     String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  /// * Admin/Master que respondeu no fórum (alternativa a teacherId).
  staffUserId String?
  question    EnrollmentLessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  staffUser   User?                    @relation("LessonQuestionStaffReply", fields: [staffUserId], references: [id])
  teacher     Teacher?                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([teacherId])
  @@index([staffUserId])
}

/// * Comunidade IGH / PII — discussão transversal entre cursos (ideias, equipes, debate).
enum IghCommunityTopicKind {
  IDEA
  TEAM
  DISCUSSION
}

enum IghCommunityPostStatus {
  PENDING
  APPROVED
  REJECTED
}

model IghCommunityTag {
  id        String                 @id @default(uuid())
  name      String                 @unique
  createdAt DateTime               @default(now())
  topics    IghCommunityTopicTag[]

  @@index([name])
}

model IghCommunityTopicTag {
  topicId String
  tagId   String
  topic   IghCommunityTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  tag     IghCommunityTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([topicId, tagId])
  @@index([tagId])
}

model IghCommunityTopic {
  id                  String                   @id @default(uuid())
  authorUserId        String
  studentId           String?
  kind                IghCommunityTopicKind
  title               String
  content             String
  status              IghCommunityPostStatus   @default(APPROVED)
  moderatedAt         DateTime?
  moderatedByUserId   String?
  moderationNote      String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  author              User                     @relation("IghCommunityTopicAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  student             Student?                 @relation(fields: [studentId], references: [id], onDelete: SetNull)
  moderatedBy         User?                    @relation("IghCommunityTopicModeratedBy", fields: [moderatedByUserId], references: [id])
  replies             IghCommunityReply[]
  tags                IghCommunityTopicTag[]

  @@index([status, createdAt(sort: Desc)])
  @@index([studentId])
  @@index([authorUserId])
  @@index([kind])
}

model IghCommunityReply {
  id                  String                 @id @default(uuid())
  topicId             String
  authorUserId        String
  studentId           String?
  content             String
  status              IghCommunityPostStatus @default(APPROVED)
  moderatedAt         DateTime?
  moderatedByUserId   String?
  moderationNote      String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  topic               IghCommunityTopic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author              User                   @relation("IghCommunityReplyAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  student             Student?               @relation(fields: [studentId], references: [id], onDelete: SetNull)
  moderatedBy         User?                  @relation("IghCommunityReplyModeratedBy", fields: [moderatedByUserId], references: [id])

  @@index([topicId, status, createdAt])
  @@index([studentId])
  @@index([authorUserId])
}

/// * Resposta de um aluno ao comentário/dúvida de outro (em "Dúvidas sobre esta aula").
model EnrollmentLessonQuestionReply {
  id           String                   @id @default(uuid())
  questionId   String
  enrollmentId String
  content      String
  createdAt    DateTime                 @default(now())
  enrollment   Enrollment               @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  question     EnrollmentLessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([enrollmentId])
}

/// * Resposta do aluno a um exercício de múltipla escolha (várias tentativas por exercício; usa-se a mais recente para exibir).
model EnrollmentLessonExerciseAnswer {
  id               String               @id @default(uuid())
  enrollmentId     String
  exerciseId       String
  selectedOptionId String
  correct          Boolean
  createdAt        DateTime             @default(now())
  enrollment       Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  exercise         CourseLessonExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, exerciseId, createdAt])
  @@index([enrollmentId, exerciseId, createdAt], map: "EnrollmentLessonExerciseAnswer_enrollmentId_exerciseId_createdA")
}

model StudentAttachment {
  id               String         @id @default(cuid())
  studentId        String
  type             AttachmentType
  fileName         String?
  mimeType         String?
  sizeBytes        Int?
  publicId         String
  url              String
  createdAt        DateTime       @default(now())
  uploadedByUserId String?
  deletedAt        DateTime?
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedByUser   User?          @relation("StudentAttachmentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([studentId, type])
}

// ————————————————— Gerência Administrativa —————————————————

/// * Ficha administrativa do colaborador. Independe de ter conta no sistema:
/// * quem já é usuário fica vinculado por `userId`, os demais existem só aqui.
model Employee {
  id                 String             @id @default(uuid())
  /// * Conta do sistema vinculada (professor, coordenador, gerente...). Nulo para quem não acessa o painel.
  userId             String?            @unique
  name               String
  cpf                String             @unique
  rg                 String?
  rgIssuer           String?
  birthDate          DateTime?          @db.Date
  email              String?
  phone              String?
  position           EmployeePosition
  /// * Rótulo livre quando o cargo oficial é mais específico que o enum (ex.: "Auxiliar de secretaria").
  positionLabel      String?
  employmentType     EmploymentType     @default(MEI)
  status             EmployeeStatus     @default(ATIVO)
  admissionDate      DateTime?          @db.Date
  terminationDate    DateTime?          @db.Date
  /// * Remuneração mensal em centavos (evita erro de arredondamento).
  monthlyPayCents    Int?
  uniformSize        UniformSize?
  /// * Numeração do calçado (texto livre: "39", "40/41"...).
  shoeSize           String?
  meiCnpj            String?
  meiCompanyName     String?
  bankName           String?
  bankAgency         String?
  bankAccount        String?
  bankAccountType    BankAccountType?
  pixKeyType         PixKeyType?
  pixKey             String?
  cep                String?
  street             String?
  number             String?
  complement         String?
  neighborhood       String?
  city               String?
  state              String?
  notes              String?
  /// * Polo de lotação (vigia, limpeza, coordenação...).
  poloId             String?
  /// * Coluna do quadro de convênios de pagamento.
  paymentAgreementId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdByUserId    String?
  deletedAt          DateTime?
  deletedByUserId    String?
  user               User?              @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  polo               Polo?              @relation(fields: [poloId], references: [id], onDelete: SetNull)
  paymentAgreement   PaymentAgreement?  @relation(fields: [paymentAgreementId], references: [id], onDelete: SetNull)
  createdByUser      User?              @relation("EmployeeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deletedByUser      User?              @relation("EmployeeDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  documents          EmployeeDocument[]
  contracts          EmployeeContract[]
  monthlyInvoices    EmployeeMonthlyInvoice[]

  @@index([deletedAt, status])
  @@index([position])
  @@index([poloId])
  @@index([paymentAgreementId])
}

/// * Anexo da ficha do colaborador: documentos pessoais, contrato, distrato e nota mensal.
model EmployeeDocument {
  id               String               @id @default(uuid())
  employeeId       String
  type             EmployeeDocumentType
  title            String?
  /// * Competência da nota mensal (sempre o dia 1º do mês de referência).
  referenceMonth   DateTime?            @db.Date
  /// * Valor da nota em centavos, quando o anexo é uma nota fiscal.
  amountCents      Int?
  fileName         String?
  mimeType         String?
  sizeBytes        Int?
  publicId         String
  url              String
  createdAt        DateTime             @default(now())
  uploadedByUserId String?
  deletedAt        DateTime?
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedByUser   User?                @relation("EmployeeDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId, type])
  @@index([referenceMonth])
}

/// * Modelo editável (TipTap) para contratos, distratos e termos de doação.
model DocumentTemplate {
  id              String               @id @default(uuid())
  type            DocumentTemplateType
  title           String
  /// * HTML TipTap com variáveis {{funcionario.nome}}, {{contrato.valor}}, etc.
  contentRich     String               @db.Text
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdByUserId String?
  createdByUser   User?                @relation("DocumentTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  contracts       EmployeeContract[]
  donations       Donation[]

  @@index([type, isActive])
}

/// * Contrato ou distrato emitido a partir de um modelo (HTML congelado + PDF).
model EmployeeContract {
  id                   String                 @id @default(uuid())
  employeeId           String
  templateId           String?
  /// * CONTRATO ou DISTRATO (o tipo do registro; o modelo pode ser do mesmo tipo).
  kind                 EmployeeContractKind   @default(CONTRATO)
  /// * Contrato original quando este registro é um distrato.
  parentContractId     String?
  startDate            DateTime               @db.Date
  endDate              DateTime?              @db.Date
  monthlyValueCents    Int?
  description          String?
  status               EmployeeContractStatus @default(RASCUNHO)
  /// * HTML com variáveis já resolvidas — não muda se o modelo for editado depois.
  renderedHtml         String                 @db.Text
  pdfUrl               String?
  pdfPublicId          String?
  signedPdfUrl         String?
  signedPdfPublicId    String?
  issuedAt             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  createdByUserId      String?
  deletedAt            DateTime?
  employee             Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template             DocumentTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  parentContract       EmployeeContract?      @relation("ContractDistrato", fields: [parentContractId], references: [id], onDelete: SetNull)
  distratos            EmployeeContract[]     @relation("ContractDistrato")
  createdByUser        User?                  @relation("EmployeeContractCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId, kind, deletedAt])
  @@index([status])
  @@index([parentContractId])
}

/// * Nota mensal do colaborador (competência única por pessoa).
model EmployeeMonthlyInvoice {
  id              String                       @id @default(uuid())
  employeeId      String
  /// * Sempre o dia 1º do mês de referência.
  referenceMonth  DateTime                     @db.Date
  amountCents     Int?
  status          EmployeeMonthlyInvoiceStatus @default(PENDENTE)
  issuedAt        DateTime?
  notes           String?
  pdfUrl          String?
  pdfPublicId     String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  createdByUserId String?
  deletedAt       DateTime?
  employee        Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdByUser   User?                        @relation("EmployeeMonthlyInvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeId, referenceMonth])
  @@index([referenceMonth, status])
  @@index([deletedAt])
}

/// * Categoria cadastrável de lançamentos financeiros (entrada ou saída).
model FinancialCategory {
  id              String              @id @default(uuid())
  name            String
  kind            FinancialEntryKind
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdByUserId String?
  createdByUser   User?               @relation("FinancialCategoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  entries         FinancialEntry[]

  @@index([kind, isActive])
  @@unique([name, kind])
}

/// * Lançamento financeiro (entrada ou saída) com anexo opcional da nota.
model FinancialEntry {
  id                   String                 @id @default(uuid())
  kind                 FinancialEntryKind
  description          String
  /// * Valor em centavos.
  amountCents          Int
  /// * Data do lançamento / da nota.
  entryDate            DateTime               @db.Date
  categoryId           String?
  paymentMethod        FinancialPaymentMethod @default(PIX)
  poloId               String?
  /// * Responsável com conta no sistema (quando houver).
  responsibleUserId    String?
  /// * Nome livre quando o responsável não tem conta.
  responsibleName      String?
  invoiceNumber        String?
  supplier             String?
  notes                String?
  attachmentUrl        String?
  attachmentPublicId   String?
  attachmentFileName   String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  createdByUserId      String?
  deletedAt            DateTime?
  category             FinancialCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  polo                 Polo?                  @relation(fields: [poloId], references: [id], onDelete: SetNull)
  responsibleUser      User?                  @relation("FinancialEntryResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdByUser        User?                  @relation("FinancialEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  donations            Donation[]

  @@index([deletedAt, entryDate])
  @@index([kind, entryDate])
  @@index([categoryId])
  @@index([poloId])
}

/// * Item do almoxarifado / estoque patrimonial.
model InventoryItem {
  id              String              @id @default(uuid())
  name            String
  /// * Código interno ou patrimônio (único quando informado).
  code            String?
  category        String?
  brand           String?
  model           String?
  /// * Número de tombamento patrimonial.
  assetTag        String?
  serialNumber    String?
  unit            String              @default("UN")
  /// * Quantidade mínima antes do alerta de estoque baixo.
  minStock        Int                 @default(0)
  location        String?
  responsibleName String?
  condition       InventoryCondition  @default(BOM)
  /// * Valor unitário estimado em centavos.
  unitValueCents  Int?
  photoUrl        String?
  photoPublicId   String?
  /// * Saldo atual (atualizado em transação com cada movimento).
  quantityOnHand  Int                 @default(0)
  notes           String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdByUserId String?
  deletedAt       DateTime?
  createdByUser   User?               @relation("InventoryItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  movements       InventoryMovement[]
  donationItems   DonationItem[]

  @@unique([code])
  @@index([deletedAt, isActive])
  @@index([quantityOnHand, minStock])
}

/// * Movimento de estoque: entrada, saída ou ajuste.
model InventoryMovement {
  id                String                @id @default(uuid())
  itemId            String
  type              InventoryMovementType
  /// * Quantidade sempre positiva; o sinal vem do tipo (AJUSTE usa quantity como saldo absoluto alvo via reason/notes ou delta).
  quantity          Int
  /// * Variação aplicada ao saldo (positiva ou negativa). Em AJUSTE, é o delta até o novo saldo.
  quantityDelta     Int
  reason            String?
  responsibleUserId String?
  responsibleName   String?
  notes             String?
  /// * Doação que originou a saída (quando houver).
  donationId        String?
  createdAt         DateTime              @default(now())
  createdByUserId   String?
  item              InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  responsibleUser   User?                 @relation("InventoryMovementResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdByUser     User?                 @relation("InventoryMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  donation          Donation?             @relation(fields: [donationId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt(sort: Desc)])
  @@index([donationId])
}

/// * Entidade que recebe doações do instituto (donatária).
model Donataria {
  id              String        @id @default(uuid())
  name            String
  document        String?
  email           String?
  phone           String?
  contactName     String?
  cep             String?
  street          String?
  number          String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?
  /// * Zona usada no termo de doação (urbana/rural).
  zone            DonatariaZone @default(URBANA)
  notes           String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdByUserId String?
  deletedAt       DateTime?
  createdByUser   User?         @relation("DonatariaCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  donations       Donation[]
  technicalVisits TechnicalVisit[]

  @@index([deletedAt, isActive])
  @@index([name])
}

/// * Doação de saída do IGH (bens e/ou dinheiro) para uma donatária.
model Donation {
  id                  String         @id @default(uuid())
  donatariaId         String
  kind                DonationKind
  donatedAt           DateTime       @db.Date
  description         String?
  /// * Valor em centavos quando a doação inclui dinheiro.
  amountCents         Int?
  /// * Quantidade de kits padrão (Computadores para Inclusão).
  kitsCount           Int            @default(0)
  /// * Atribuição política/entidade no termo ("Pertence a").
  belongsTo           String?
  /// * Local e data por extenso impressos no termo.
  placeDateText       String?
  /// * Número sequencial do termo (atribuído na confirmação).
  termNumber          Int?           @unique
  status              DonationStatus @default(RASCUNHO)
  templateId          String?
  renderedHtml        String?        @db.Text
  pdfUrl              String?
  pdfPublicId         String?
  /// * Lançamento financeiro gerado na confirmação (doação em dinheiro).
  financialEntryId    String?
  /// * Se os itens de bens já foram baixados do estoque.
  inventoryPosted     Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdByUserId     String?
  deletedAt           DateTime?
  donataria           Donataria      @relation(fields: [donatariaId], references: [id], onDelete: Restrict)
  template            DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  financialEntry      FinancialEntry?   @relation(fields: [financialEntryId], references: [id], onDelete: SetNull)
  createdByUser       User?             @relation("DonationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items               DonationItem[]
  inventoryMovements  InventoryMovement[]

  @@index([donatariaId, donatedAt])
  @@index([status, deletedAt])
  @@index([termNumber])
}

model DonationItem {
  id              String         @id @default(uuid())
  donationId      String
  inventoryItemId String?
  /// * Nome congelado no momento da doação.
  name            String
  quantity        Int
  unit            String         @default("UN")
  donation        Donation       @relation(fields: [donationId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([donationId])
  @@index([inventoryItemId])
}

/// * Catálogo de tipos de equipamento (CPU, Monitor…) usado em kits e doações.
/// * Diferente do estoque patrimonial (quantidade/saldo).
model EquipmentCatalogItem {
  id              String   @id @default(uuid())
  name            String
  /// * Se > 0, entra na composição padrão do kit por unidade de kit.
  quantityPerKit  Int      @default(0)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  deletedAt       DateTime?
  createdByUser   User?    @relation("EquipmentCatalogCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([name])
  @@index([deletedAt, isActive, sortOrder])
}

/// * Visita técnica / protocolo de implementação de laboratório.
model TechnicalVisit {
  id                       String                         @id @default(uuid())
  locationName             String
  municipality             String
  state                    String                         @default("PA")
  address                  String?
  localContact             String?
  visitedAt                DateTime                       @db.Date
  visitors                 String?
  /// * Meta pedagógica (valores de referência / planejados).
  metaStudents             Int?
  metaClassGroups          Int?
  metaStudentsPerClass     Int?
  classDuration            String?
  classesPerWeek           String?
  classDays                String?
  pedagogicalPlan          String?
  /// * Texto livre dos padrões estruturais (laboratório).
  structuralStandards      String?                        @db.Text
  finalClassification      TechnicalVisitClassification   @default(APTA_COM_PENDENCIAS)
  finalNotes               String?                        @db.Text
  /// * Vínculo opcional com donatária cadastrada.
  donatariaId              String?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  createdByUserId          String?
  deletedAt                DateTime?
  donataria                Donataria?                     @relation(fields: [donatariaId], references: [id], onDelete: SetNull)
  createdByUser            User?                          @relation("TechnicalVisitCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  checklistItems           TechnicalVisitChecklistItem[]

  @@index([visitedAt])
  @@index([municipality])
  @@index([finalClassification, deletedAt])
  @@index([donatariaId])
}

model TechnicalVisitChecklistItem {
  id           String                     @id @default(uuid())
  visitId      String
  /// * Chave estável (ex.: COMPUTADORES).
  key          String
  label        String
  standard     String
  status       TechnicalVisitItemStatus   @default(PENDENTE)
  observation  String?
  sortOrder    Int                        @default(0)
  visit        TechnicalVisit             @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, sortOrder])
  @@unique([visitId, key])
}

/// * Dados da instituição doadora usados nos termos de doação (singleton).
model DonorInstitutionSettings {
  id                   String   @id @default(uuid())
  name                 String?
  document             String?
  email                String?
  address              String?
  city                 String?
  state                String?
  cep                  String?
  phone                String?
  representativeName   String?
  representativeRole   String?
  representativeCpf    String?
  updatedAt            DateTime @updatedAt
  updatedByUserId      String?
  updatedByUser        User?    @relation("DonorInstitutionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

/// * Meta anual de doação de computadores e formação de pessoas.
model AnnualGoal {
  id                 String   @id @default(uuid())
  year               Int      @unique
  computersTarget   Int      @default(0)
  peopleTarget       Int      @default(0)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdByUserId    String?
  createdByUser      User?    @relation("AnnualGoalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([year])
}

/// * Coluna do quadro de convênios de pagamento (Kanban de colaboradores).
model PaymentAgreement {
  id              String     @id @default(uuid())
