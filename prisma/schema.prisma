  /// * URL pública do PNG composto (APImages / CDN).
  imageUrl         String
  createdAt        DateTime @default(now())
  createdByUserId  String?
  createdBy        User?    @relation("SiteQrCodeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
}

model SiteAboutPage {
