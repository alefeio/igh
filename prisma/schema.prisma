  @@index([deletedAt, isActive, sortOrder])
}

model SiteSettings {
  id                    String   @id @default(uuid())
  siteName              String?
  logoUrl               String?
  /// * Altura da logo no menu/rodapé do site (px). Padrão 48.
  logoHeightPx          Int      @default(48)
  faviconUrl            String?
  primaryColor          String?
  secondaryColor        String?
  contactEmail          String?
  contactPhone          String?
  contactWhatsapp       String?
  businessHours         String?
  socialInstagram       String?
  socialFacebook        String?
  socialYoutube         String?
  socialLinkedin        String?
  seoTitleDefault       String?
  seoDescriptionDefault String?
  updatedAt             DateTime @updatedAt
  addresses             Json?
  /// * Base URL do site (https://...) para placeholders {link}, {link_area_aluno} em e-mails quando APP_URL não está no .env
  publicAppUrl          String?
  /// * Cidade padrão impressa no certificado quando o local da turma não define uma (ex.: "Brasília").
  certificateCity       String?
  /// * UF padrão do certificado (ex.: "DF"). Combinada com certificateCity na frente ("Brasília/DF").
  certificateCityState  String?
  /// * Exibe a mascote ao lado da logo no menu institucional (só se houver URL).
  navbarMascotEnabled   Boolean  @default(true)
  /// * Imagem da mascote com o menu no topo (sem scroll). Sem URL = não exibe.
