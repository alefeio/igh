  /// * Imagem da mascote com o menu em scroll. Sem URL = usa a do topo, se houver.
  navbarMascotScrolledUrl   String?
}

/// * QR Codes gerados em Configurações do site (título, link alvo, imagem central opcional, PNG final no CDN).
model SiteQrCode {
