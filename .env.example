# Desenvolvimento local (DEVELOPMENT ONLY)
#
# Copie este arquivo para .env.local. Não use o .env de produção nesta pasta.
# O Postgres destes URLs existe só no Docker de docker-compose.dev.yml.
# Não há pooler local: APP_DATABASE_URL e APP_DIRECT_URL apontam para a mesma instância.
# Não coloque db.prisma.io, Neon, Vercel Postgres nem dados de produção aqui.
APP_DATABASE_URL="postgresql://igh_dev:igh_dev_local_only@127.0.0.1:5432/igh_dev"
APP_DIRECT_URL="postgresql://igh_dev:igh_dev_local_only@127.0.0.1:5432/igh_dev"
# Opcional: tamanho do pool do node-pg (padrão dev=5, prod=1 na Vercel). Aumente só se o banco aguentar.
PRISMA_PG_POOL_MAX=1
# Quadro de Atividades (piloto). Seguro por padrão: desativado.
# Ative somente no ambiente IGH; no INAC deixe ausente ou diferente de "true".
# BOARD_ACTIVITIES_ENABLED=true
# UUID do PoloLocation (unidade operacional) — obrigatório quando ENABLED=true. Sem hardcode de Belém.
# BOARD_ACTIVITIES_POLO_LOCATION_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Não use usuário / URL exclusivos de migração (ex.: prisma_migration) no app — só em `prisma migrate` com APP_DIRECT_URL.
# Auth. Gere um valor só para esta máquina. Não reutilize o segredo de produção.
AUTH_SECRET="dev-local-only-change-me"

# Identidade da instituição atendida por este deploy (src/lib/brand.ts)
#
# O mesmo código serve mais de uma instituição: cada projeto na Vercel tem seu
# próprio banco e seu próprio conjunto de variáveis. Sem nada configurado aqui,
# os defaults do IGH continuam valendo.
#
# São NEXT_PUBLIC_ porque componentes client também exibem esses rótulos — logo
# são embutidos no bundle durante o build. Defina-as ANTES de fazer o deploy.
#
# Logo, favicon, cores, contatos e redes sociais NÃO ficam aqui: são editáveis
# no admin em /admin/site/configuracoes.
NEXT_PUBLIC_BRAND_SHORT_NAME="IGH"
NEXT_PUBLIC_BRAND_LEGAL_NAME="Instituto Gustavo Hessel"
# Opcionais: fallback de SEO quando o banco não define título/descrição padrão.
NEXT_PUBLIC_BRAND_SEO_TITLE=""
NEXT_PUBLIC_BRAND_SEO_DESCRIPTION=""

# Certificado de conclusão
# Pasta da arte (PDFs frente/verso), relativa à raiz do projeto. Cada instituição
# tem a sua, já que os dois deploys compartilham o mesmo repositório.
CERTIFICATE_TEMPLATE_DIR="assets/certificates"
# Fallback opcional da cidade impressa no certificado. Preferência:
# 1) cidade do local do polo da turma (editável em /admin/polos)
# 2) Configurações do site (/admin/site/configuracoes → Certificados)
# 3) estas variáveis (só se as anteriores estiverem vazias)
CERTIFICATE_CITY=""
CERTIFICATE_CITY_STATE=""

# Cloudflare Turnstile (anti-bot em /login e /cadastro). Sem chaves, honeypot + rate limit ainda protegem.
# Crie o widget em dash.cloudflare.com → Turnstile. Não é necessário trocar os nameservers do domínio
# (ex.: ns1.vercel-dns.com) nem colocar o site no proxy da Cloudflare — isso só vale se quiser CDN/WAF no site inteiro.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Cloudinary — opcional em DEV. Deixe vazio para não usar a conta de produção.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="igh/students"

# Upload (APIMG) — opcional em DEV.
APIMG_API_KEY=""
APIMG_UPLOAD_URL="https://apimg.com.br/v1/upload"
# Prefixos lógicos das pastas. Separe por instituição para não misturar arquivos
# das duas instâncias na mesma conta Apimages.
APIMG_UPLOAD_FOLDER="igh/students"
APIMG_SITE_UPLOAD_FOLDER="igh/site"

# App / E-mail
APP_URL="http://localhost:3000"
# URL pública usada em metadataBase, Open Graph e canonical.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EMAIL_FROM="noreply@seudominio.com"

EMAIL_PROVIDER="resend"
# Vazio de propósito: sem esta chave o app em desenvolvimento não envia e-mail.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@seudominio.com"
RESEND_FROM_NAME="Instituto Gustavo Hessel"
RESEND_WEBHOOK_SECRET=""
# Limite diário do Resend (plano gratuito: 100). E-mails transacionais enfileiram quando esgotado.
RESEND_DAILY_EMAIL_LIMIT=100

# SMS. mock evita envio real. Não preencha ZENVIA_API_KEY em DEV.
SMS_PROVIDER="mock"
ZENVIA_FROM=""

# Cron / Segredos internos. Os crons do vercel.json não rodam no npm run dev.
SMS_CRON_SECRET=""
EMAIL_CRON_SECRET=""
CRON_SECRET=""

# Contato público (site)
PUBLIC_CONTACT_PHONE="(xx) xxxxx-xxxx"
PUBLIC_SUPPORT_EMAIL="suporte@seudominio.com"